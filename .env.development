# Dev mode — backend on this Mac's LAN IP so PHONES can reach it too: the
# /api/graphql proxy uses this server-side (the Mac resolves its own LAN IP),
# and the fleet/ride sockets derive their origin from it client-side, where
# the phone reaches the Mac over Wi-Fi. The /admin-api PATH IS REQUIRED.
# The IP changes when the Mac joins a different network — check with
# `ipconfig getifaddr en0`, update this line and restart the dev server.
# Phone and Mac must be on the SAME Wi-Fi.
NEXT_PUBLIC_VENDURE_ADMIN_API=http://localhost:80/admin-api
# Local-only alternative (desktop testing without phones):
# NEXT_PUBLIC_VENDURE_ADMIN_API=http://localhost:80/admin-api
# NEXT_PUBLIC_VENDURE_ADMIN_API=http://localhost:3001/admin-api
NEXT_PUBLIC_SOUTH_MITHAI_INVOICE_CHANNELS=8
